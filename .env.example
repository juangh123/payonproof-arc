# PayOnProof web app configuration (public values only: never put keys or tokens here).
# Copy to .env and restart the dev server after changing anything.

# Arc Testnet deployment (default)
VITE_CHAIN=testnet
VITE_JOBS_ADDRESS=0x08617a0786fa9c5c380f8cc8e6366ac91d16d851
VITE_JOBS_DEPLOY_BLOCK=69776195

# Arc mainnet (chain 5042): fill these in after you deploy from your own wallet, then comment out the testnet block above.
# VITE_CHAIN=mainnet
# VITE_JOBS_ADDRESS=<mainnet contract address>
# VITE_JOBS_DEPLOY_BLOCK=<mainnet deployment block>
